{
  "openapi": "3.1.0",
  "info": {
    "title": "SAM3 service",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/InstanceRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ConceptRequest"
                  }
                ],
                "title": "Body",
                "discriminator": {
                  "propertyName": "mode",
                  "mapping": {
                    "instance": "#/components/schemas/InstanceRequest",
                    "concept": "#/components/schemas/ConceptRequest"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Box": {
        "properties": {
          "x1": {
            "type": "number",
            "title": "X1"
          },
          "y1": {
            "type": "number",
            "title": "Y1"
          },
          "x2": {
            "type": "number",
            "title": "X2"
          },
          "y2": {
            "type": "number",
            "title": "Y2"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "title": "Box"
      },
      "ConceptRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "image_base64": {
            "type": "string",
            "minLength": 1,
            "title": "Image Base64"
          },
          "mode": {
            "type": "string",
            "const": "concept",
            "title": "Mode"
          },
          "text": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Text"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          },
          "max_instances": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Instances"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "image_base64",
          "mode",
          "text"
        ],
        "title": "ConceptRequest",
        "description": "Text -> danh sách instance."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageInfo": {
        "properties": {
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "title": "ImageInfo"
      },
      "InstanceOut": {
        "properties": {
          "mask_png_base64": {
            "type": "string",
            "title": "Mask Png Base64"
          },
          "box": {
            "$ref": "#/components/schemas/OutBox"
          },
          "area": {
            "type": "integer",
            "title": "Area"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "score_type": {
            "type": "string",
            "enum": [
              "predicted_iou",
              "detection_confidence"
            ],
            "title": "Score Type"
          },
          "prompt_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Id"
          }
        },
        "type": "object",
        "required": [
          "mask_png_base64",
          "box",
          "area",
          "score",
          "score_type"
        ],
        "title": "InstanceOut"
      },
      "InstanceRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "image_base64": {
            "type": "string",
            "minLength": 1,
            "title": "Image Base64"
          },
          "mode": {
            "type": "string",
            "const": "instance",
            "title": "Mode"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Points"
          },
          "box": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Box"
              },
              {
                "type": "null"
              }
            ]
          },
          "boxes": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Box"
                },
                "type": "array",
                "maxItems": 12,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Boxes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "image_base64",
          "mode"
        ],
        "title": "InstanceRequest",
        "description": "Điểm/box đơn hoặc nhiều box độc lập -> instance."
      },
      "ModelMeta": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source_sha": {
            "type": "string",
            "title": "Source Sha"
          },
          "checkpoint_revision": {
            "type": "string",
            "title": "Checkpoint Revision"
          },
          "checkpoint_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Sha256"
          },
          "precision": {
            "type": "string",
            "title": "Precision"
          },
          "device": {
            "type": "string",
            "title": "Device"
          }
        },
        "type": "object",
        "required": [
          "name",
          "source_sha",
          "checkpoint_revision",
          "checkpoint_sha256",
          "precision",
          "device"
        ],
        "title": "ModelMeta"
      },
      "OutBox": {
        "properties": {
          "x1": {
            "type": "integer",
            "title": "X1"
          },
          "y1": {
            "type": "integer",
            "title": "Y1"
          },
          "x2": {
            "type": "integer",
            "title": "X2"
          },
          "y2": {
            "type": "integer",
            "title": "Y2"
          }
        },
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "title": "OutBox"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "label": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y",
          "label"
        ],
        "title": "Point"
      },
      "PredictResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "instance",
              "concept"
            ],
            "title": "Mode"
          },
          "image": {
            "$ref": "#/components/schemas/ImageInfo"
          },
          "model": {
            "$ref": "#/components/schemas/ModelMeta"
          },
          "timing": {
            "$ref": "#/components/schemas/Timing"
          },
          "instances": {
            "items": {
              "$ref": "#/components/schemas/InstanceOut"
            },
            "type": "array",
            "title": "Instances"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "mode",
          "image",
          "model",
          "timing",
          "instances"
        ],
        "title": "PredictResponse"
      },
      "Timing": {
        "properties": {
          "queue_ms": {
            "type": "number",
            "title": "Queue Ms"
          },
          "inference_ms": {
            "type": "number",
            "title": "Inference Ms"
          },
          "total_ms": {
            "type": "number",
            "title": "Total Ms"
          }
        },
        "type": "object",
        "required": [
          "queue_ms",
          "inference_ms",
          "total_ms"
        ],
        "title": "Timing"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
