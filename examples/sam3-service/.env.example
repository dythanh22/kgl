# Sao chép thành .env (KHÔNG commit .env). File này không chứa bí mật.

# --- Xác thực (bắt buộc) ----------------------------------------------------
# Tạo bằng: openssl rand -hex 32   (tối thiểu 24 ký tự)
SAM3_API_KEY=
# Chỉ để phát triển cục bộ; không bao giờ đặt true ở production.
SAM3_AUTH_DISABLED=false

# --- Truy vết model (hiển thị trong mỗi response) ---------------------------
# Checkpoint đã xác minh trên T4/A4000; thay cả hai nếu dùng weights khác.
SAM3_CHECKPOINT_REVISION=3c879f39826c281e95690f02c7821c4de09afae7
# Service xác minh SHA-256 lúc khởi động và dừng nếu file không khớp.
SAM3_CHECKPOINT_SHA256=9999e2341ceef5e136daa386eecb55cb414446a00ac2b55eb2dfd2f7c3cf8c9e

# --- Model ------------------------------------------------------------------
# Đường dẫn TRONG container (host mount vào /weights, chỉ đọc).
SAM3_CHECKPOINT_PATH=/weights/sam3.pt
# cuda | cpu. Chọn GPU bằng NVIDIA_VISIBLE_DEVICES/compose, không dùng "cuda:0".
SAM3_DEVICE=cuda
# auto: BF16 nếu GPU compute capability >= 8, ngược lại FP32 (T4/P100 -> FP32).
SAM3_PRECISION=auto
# Số key thiếu tối đa khi nạp checkpoint. 0 = bất kỳ key thiếu nào cũng dừng.
# Chỉ tăng sau khi đã đọc danh sách key trong log và xác nhận chúng vô hại.
SAM3_MAX_MISSING_KEYS=0
SAM3_WARMUP=true
SAM3_EMPTY_CACHE_EACH_REQUEST=false

# --- Giới hạn đầu vào -------------------------------------------------------
SAM3_MAX_IMAGE_BYTES=20971520
# Chưa đo VRAM ở kích thước này; hạ xuống nếu gặp gpu_out_of_memory.
SAM3_MAX_IMAGE_PIXELS=12000000
SAM3_MAX_IMAGE_SIDE=8192
SAM3_MAX_POINTS=16
SAM3_MAX_TEXT_CHARS=128
SAM3_MAX_INSTANCES=100
SAM3_DEFAULT_THRESHOLD=0.5
SAM3_MIN_THRESHOLD=0.1

# --- Thực thi ---------------------------------------------------------------
# Số request chờ tối đa (không tính request đang chạy). Đầy -> 503 queue_full.
SAM3_QUEUE_SIZE=8
# Tổng thời gian cho một request, gồm cả chờ trong hàng đợi.
# Phải NHỎ HƠN timeout của reverse proxy và của client (Nuclio eventTimeout...).
SAM3_REQUEST_TIMEOUT_S=60
SAM3_DECODE_CONCURRENCY=2
SAM3_EXIT_ON_FATAL=true
SAM3_LOG_LEVEL=INFO

# --- Compose (đọc bởi docker compose, không phải bởi ứng dụng) ---------------
# Bind mặc định chỉ loopback; nền tảng cần proxy vào container có thể đặt 0.0.0.0.
# SAM3_BIND_ADDRESS=127.0.0.1
# SAM3_WEIGHTS_DIR=/srv/sam3/weights
# SAM3_PUBLISH_PORT=8000
# SAM3_IMAGE_TAG=dev
# SAM3_SHA=2345a4ad109ac29c569da749c91d84f10dc08c40
